+    def _forward_sparse_mla_swa_decode_triton(
+        self,
+        q: torch.Tensor,
+        swa_k_cache: torch.Tensor,
+        swa_metadata: "DeepseekSparseSWAMetadata",
+        output: torch.Tensor,
+    ) -> None:
+        """Portable Triton SM80/Ada fallback for SWA-only decode."""
+        num_decodes = swa_metadata.num_decodes
+        num_decode_tokens = swa_metadata.num_decode_tokens
+        mtp_decode = num_decode_tokens != num_decodes
+
+        assert swa_metadata.decode_swa_lens is not None
+        assert swa_metadata.decode_swa_indices is not None
+        assert swa_metadata.seq_lens is not None
+        swa_lens = swa_metadata.decode_swa_lens[:num_decode_tokens]
+        swa_indices = swa_metadata.decode_swa_indices[:num_decode_tokens]
+        max_swa_len = swa_metadata.decode_swa_indices.shape[-1]
+        head_block_size = sparse_mla_decode_head_block_size(num_decode_tokens)
+
+        if not mtp_decode:
+            # One query row per sequence: the paged kernel derives the
+            # contiguous SWA window from seq_lens / gather_lens.
+            fp8ds_paged_sparse_mla_attention_with_sink_multihead(
+                q=q,
+                k_cache=swa_k_cache,
+                seq_lens=swa_metadata.seq_lens[:num_decodes],
+                gather_lens=swa_lens,
+                block_table=swa_metadata.block_table[:num_decodes],
+                block_size=swa_metadata.block_size,
+                candidate_offset=0,
+                num_candidates=max_swa_len,
+                scale=self.scale,
+                attn_sink=self.attn_sink,
+                output=output,
+                head_block_size=head_block_size,
+                num_heads=self.n_local_heads,
+            )
+            if output.shape[1] > self.n_local_heads:
+                output[:, self.n_local_heads :].zero_()
+            return
+
+        # MTP: several query tokens per sequence attend to the same cache, so
+        # accumulate the per-token SWA slots with an online softmax and add the
+        # sink once at the end.
+        max_score, denom, acc = current_workspace_manager().get_simultaneous(
+            ((num_decode_tokens, self.n_local_heads), torch.float32),
+            ((num_decode_tokens, self.n_local_heads), torch.float32),
+            ((num_decode_tokens, self.n_local_heads, q.shape[-1]), torch.float32),
+        )
+        max_score.fill_(float("-inf"))
+        denom.zero_()
+        acc.zero_()
+        accumulate_fp8ds_global_slots_sparse_mla_attention_chunk_multihead(
+            q=q,
+            k_cache=swa_k_cache,
+            slot_ids=swa_indices,
+            lens=swa_lens,
+            block_size=swa_metadata.block_size,
+            scale=self.scale,
+            max_score=max_score,
+            denom=denom,
+            acc=acc,
+            head_block_size=head_block_size,
+        )
+        finish_sparse_mla_attention_with_sink(
+            max_score,
+            denom,
+            acc,
+            self.attn_sink,
+            output=output,
+        )
+        if output.shape[1] > self.n_local_heads:
+            output[:, self.n_local_heads :].zero_()
+
+    def _forward_sparse_mla_compressed_decode_triton(
+        self,
+        q: torch.Tensor,
+        compressed_k_cache: torch.Tensor,
+        swa_k_cache: torch.Tensor,
+        topk_indices: torch.Tensor,
+        topk_lens: torch.Tensor,
+        swa_metadata: "DeepseekSparseSWAMetadata",
+        attn_metadata: DeepseekV4FlashMLAMetadata,
+        output: torch.Tensor,
+    ) -> None:
+        """Portable Triton SM80/Ada fallback for compressed + SWA decode."""
+        num_decodes = swa_metadata.num_decodes
+        num_decode_tokens = swa_metadata.num_decode_tokens
+        mtp_decode = num_decode_tokens != num_decodes
+
+        assert swa_metadata.decode_swa_lens is not None
+        assert swa_metadata.decode_swa_indices is not None
+        assert swa_metadata.seq_lens is not None
+        max_swa_len = swa_metadata.decode_swa_indices.shape[-1]
+        compressed_topk = topk_indices.shape[-1]
+        compressed_block_size = attn_metadata.block_size // self.compress_ratio
+        compressed_slot_ids = (
+            topk_indices[:, 0, :] if topk_indices.dim() == 3 else topk_indices
+        )
+        swa_lens = swa_metadata.decode_swa_lens[:num_decode_tokens]
+        swa_indices = swa_metadata.decode_swa_indices[:num_decode_tokens]
+        head_block_size = sparse_mla_decode_head_block_size(num_decode_tokens)
+
+        if not mtp_decode:
+            fp8ds_global_paged_sparse_mla_attention_with_sink_multihead(
+                q=q,
+                compressed_k_cache=compressed_k_cache,
+                slot_ids=compressed_slot_ids,
+                topk_lens=topk_lens,
+                compressed_block_size=compressed_block_size,
+                swa_k_cache=swa_k_cache,
+                seq_lens=swa_metadata.seq_lens[:num_decodes],
+                gather_lens=swa_lens,
+                block_table=swa_metadata.block_table[:num_decodes],
+                swa_block_size=swa_metadata.block_size,
+                num_compressed_candidates=compressed_topk,
+                num_swa_candidates=max_swa_len,
+                scale=self.scale,
+                attn_sink=self.attn_sink,
+                output=output,
+                head_block_size=head_block_size,
+                num_heads=self.n_local_heads,
+            )
+            if output.shape[1] > self.n_local_heads:
+                output[:, self.n_local_heads :].zero_()
+            return
+
+        # MTP: the paged kernel assumes one query row per sequence, so gather
+        # the compressed and SWA candidate sets into a single online-softmax
+        # state (the two subsets merge associatively) and finish once.
+        topk_chunk_size = min(compressed_topk, triton_sparse_mla_topk_chunk_size())
+        max_score, denom, acc = current_workspace_manager().get_simultaneous(
+            ((num_decode_tokens, self.n_local_heads), torch.float32),
+            ((num_decode_tokens, self.n_local_heads), torch.float32),
+            ((num_decode_tokens, self.n_local_heads, q.shape[-1]), torch.float32),
+        )
+        max_score.fill_(float("-inf"))
+        denom.zero_()
+        acc.zero_()
+        for chunk_start in range(0, compressed_topk, topk_chunk_size):
+            chunk_end = min(chunk_start + topk_chunk_size, compressed_topk)
+            accumulate_fp8ds_global_slots_sparse_mla_attention_chunk_multihead(
+                q=q,
+                k_cache=compressed_k_cache,
+                slot_ids=compressed_slot_ids[:, chunk_start:chunk_end],
+                lens=topk_lens,
+                block_size=compressed_block_size,
+                scale=self.scale,
+                max_score=max_score,
+                denom=denom,
+                acc=acc,
+                candidate_offset=chunk_start,
+                head_block_size=head_block_size,
+            )
+        accumulate_fp8ds_global_slots_sparse_mla_attention_chunk_multihead(
+            q=q,
+            k_cache=swa_k_cache,
+            slot_ids=swa_indices,
+            lens=swa_lens,
+            block_size=swa_metadata.block_size,
+            scale=self.scale,
+            max_score=max_score,
+            denom=denom,
+            acc=acc,
+            head_block_size=head_block_size,
+        )
+        finish_sparse_mla_attention_with_sink(
+            max_score,
+            denom,
+            acc,
+            self.attn_sink,
+            output=output,
+        )
+        if output.shape[1] > self.n_local_heads:
+            output[:, self.n_local_heads :].zero_()
+
     def _forward_sparse_mla_prefill_triton(
         self,
         q: torch.Tensor,
