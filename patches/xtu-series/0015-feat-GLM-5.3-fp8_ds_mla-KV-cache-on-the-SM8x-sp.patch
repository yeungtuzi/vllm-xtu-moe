+    def _fp8_flash_mla_kernel(
+        self,
+        q: torch.Tensor,
+        kv_c_and_k_pe_cache: torch.Tensor,
+        topk_indices: torch.Tensor,
+        kernel_metadata: Any,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        """Decode over packed NoPE-512 fp8 rows on SM8x.
+
+        Upstream reaches FlashMLA here, which is SM90+. Dequantize the rows this
+        call references into a bounded bf16 table and reuse the bf16 body; the
+        bound keeps a whole context from being materialized.
+        """
+        # q arrives as (batch, seq, heads, dim) from the base reshape; flatten the
+        # leading axes instead of assuming a single batch, then restore them.
+        lead = q.shape[:-2]
+        heads, dim = q.shape[-2], q.shape[-1]
+        q2 = q.reshape(-1, heads, dim)
+        idx = topk_indices.reshape(q2.shape[0], -1)
+
+        cache = kv_c_and_k_pe_cache
+        assert cache.dim() == 3, f"expected [blocks, bs, 528], got {cache.shape}"
+        num_rows = idx.numel()
+        # ds_mla row = 512 B fp8 + 16 B scales + 128 B bf16 RoPE; the kernel
+        # gathers 576 bf16 columns and the v-part output is the first 512.
+        head_dim = 512 + 64
+        # Zero-filled on purpose: rows whose slot id is negative are masked by
+        # the kernel, but uninitialised memory there could still be NaN and
+        # NaN * 0 poisons the softmax.
+        table = torch.zeros(
+            (num_rows, head_dim), dtype=torch.bfloat16, device=cache.device
+        )
+        dst_rows = torch.arange(
+            num_rows, dtype=idx.dtype, device=cache.device
+        ).reshape(idx.shape)
+        dst_rows = torch.where(idx >= 0, dst_rows, -1)
+        gather_dequant_fp8ds_nope(
+            cache,
+            idx.reshape(-1),
+            table,
+            dst_rows.reshape(-1),
+            cache.shape[1],
+            cache.stride(1),
+        )
+        out, _ = self._bf16_flash_mla_kernel(q2, table, dst_rows)
+        out = out[..., :512]
+        return out.reshape(*lead, out.shape[-2], out.shape[-1]), None
+
