+@triton.jit
+def _gather_dequant_fp8ds_nope_kernel(
+    src_ptr,
+    dst_ptr,
+    src_row_ptr,
+    dst_row_ptr,
+    stride_dst_r: tl.constexpr,
+    stride_dst_d: tl.constexpr,
+    cache_block_size: tl.constexpr,
+    entry_stride: tl.constexpr,
+    data_bytes: tl.constexpr,
+    scale_count: tl.constexpr,
+    rope_bytes: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    """One ``fp8_ds_mla`` cache row -> bf16, one program per row pair.
+
+    The row is 656 bytes and *row interleaved*, exactly as
+    ``concat_and_cache_ds_mla_kernel`` writes it:
+
+        [0, 512)      512 x e4m3 NoPE data
+        [512, 528)    4 x fp32 tile scales, one per 128-element tile
+        [528, 656)    64 x bf16 RoPE tail (zeroed when pe_dim == 0)
+
+    The writer stores the scales as plain fp32 (rounded to powers of two), so
+    dequantisation is one multiply: no ue8m0 decode and no block of 32.
+    """
+    row_idx = tl.program_id(0)
+    slot_id = tl.load(src_row_ptr + row_idx)
+    if slot_id >= 0:
+        block_idx = slot_id // cache_block_size
+        pos_in_block = slot_id % cache_block_size
+        row_ptr = (
+            src_ptr
+            + block_idx.to(tl.int64) * cache_block_size * entry_stride
+            + pos_in_block * entry_stride
+        )
+
+        offs = tl.arange(0, BLOCK_D)
+        mask = offs < data_bytes
+        x = _e4m3_uint8_to_f32(tl.load(row_ptr + offs, mask=mask, other=0))
+        scale_ptr = (row_ptr + data_bytes).to(tl.pointer_type(tl.uint32))
+        raw = tl.load(scale_ptr + offs // (data_bytes // scale_count), mask=mask, other=0)
+        dequant = x * raw.to(tl.float32, bitcast=True)
+
+        dst_row = tl.load(dst_row_ptr + row_idx)
+        tl.store(
+            dst_ptr + dst_row * stride_dst_r + offs * stride_dst_d,
+            dequant.to(tl.bfloat16),
+            mask=mask,
+        )
+        if rope_bytes > 0:
+            r_offs = tl.arange(0, rope_bytes // 2)
+            rope_ptr = (row_ptr + data_bytes + scale_count * 4).to(tl.pointer_type(tl.uint16))
+            rope = tl.load(rope_ptr + r_offs)
+            # The destination table is bf16, so the data part occupies
+            # ``data_bytes`` *elements* (512), not bytes; the RoPE tail follows
+            # at element offset ``data_bytes``.
+            base = (dst_ptr + dst_row * stride_dst_r).to(tl.pointer_type(tl.uint16))
+            tl.store(base + data_bytes + r_offs, rope)
+
+
+FP8_DS_MLA_DATA_BYTES = 512         # 512 x e4m3 NoPE data
+FP8_DS_MLA_SCALE_COUNT = 4          # one fp32 per 128-element tile
+FP8_DS_MLA_SCALE_BYTES = 16         # 4 x fp32
+FP8_DS_MLA_ROPE_BYTES = 128         # 64 x bf16 RoPE tail
+FP8_DS_MLA_ROW_BYTES = FP8_DS_MLA_DATA_BYTES + FP8_DS_MLA_SCALE_BYTES + FP8_DS_MLA_ROPE_BYTES
+
+
+def gather_dequant_fp8ds_nope(
+    src_cache: torch.Tensor,
+    src_rows: torch.Tensor,
+    dst: torch.Tensor,
+    dst_rows: torch.Tensor,
+    cache_block_size: int,
+    entry_stride: int = 656,
+) -> None:
+    """Dequantize the referenced NoPE-512 fp8 rows into ``dst`` (bf16).
+
+    Args:
+        src_cache: uint8 packed cache ``[num_blocks, cache_block_size, 528]``.
+        src_rows: int32 physical slot ids, negative meaning "skip".
+        dst: bf16 destination table.
+        dst_rows: int32 destination row for each source row.
+        cache_block_size: rows per cache page.
+        block_stride: bytes per cache page (``src_cache.stride(0)``).
+    """
+    assert src_cache.dtype == torch.uint8, src_cache.dtype
+    assert src_cache.dim() == 3, src_cache.shape
+    assert dst.dtype == torch.bfloat16, dst.dtype
+    num_rows = src_rows.numel()
+    if num_rows == 0:
+        return
+    # 656 B ds_mla row: 512 B fp8 data + 16 B scales + 128 B bf16 RoPE.
+    _gather_dequant_fp8ds_nope_kernel[(num_rows,)](
+        src_cache,
+        dst,
+        src_rows,
+        dst_rows,
+        dst.stride(0),
+        dst.stride(1),
+        cache_block_size=cache_block_size,
+        entry_stride=entry_stride,
+        data_bytes=FP8_DS_MLA_DATA_BYTES,
+        scale_count=FP8_DS_MLA_SCALE_COUNT,
+        rope_bytes=FP8_DS_MLA_ROPE_BYTES,
+        BLOCK_D=triton.next_power_of_2(FP8_DS_MLA_DATA_BYTES),
+        num_warps=4,
+    )
+
+
+def prefill_row_map(
+    block_table: torch.Tensor,
+    workspace_starts: torch.Tensor,
+    block_size: int,
+    total: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Map workspace rows to source cache slots for the fp8 prefill gather.
+
+    Reproduces the upstream ``map_gather_page_task`` semantics: one request per
+    span of ``workspace_starts``, whole context, no sequence offset (chunks are
+    split on request boundaries). Rows outside every span are marked -1, which
+    the gather kernel skips.
+    """
+    device = block_table.device
+    if total == 0:
+        empty = torch.empty(0, dtype=torch.int32, device=device)
+        return empty, empty
+    assert workspace_starts.dtype == torch.int32 and workspace_starts.is_contiguous()
+    if workspace_starts.numel() > 1 and bool(
+        (workspace_starts[1:] < workspace_starts[:-1]).any()
+    ):
+        raise ValueError(
+            "workspace_starts must be non-decreasing within a chunk; "
+            f"got {workspace_starts.tolist()}"
+        )
+    rows = torch.arange(total, dtype=torch.int32, device=device)
+    req_of_row = (torch.searchsorted(workspace_starts, rows, right=True) - 1).clamp_(
+        0, workspace_starts.numel() - 1
+    )
+    ends = torch.cat(
+        [workspace_starts[1:], torch.tensor([total], dtype=torch.int32, device=device)]
+    )
+    pos_in_req = (rows - workspace_starts[req_of_row]).clamp_min(0)
+    invalid = pos_in_req >= (ends[req_of_row] - workspace_starts[req_of_row]).clamp_min(0)
+    block_idx = (pos_in_req // block_size).clamp_max(block_table.shape[1] - 1)
+    block = block_table[req_of_row, block_idx]
+    src_rows = (block * block_size + (pos_in_req % block_size)).to(torch.int32)
+    invalid = invalid | (block < 0)
+    return torch.where(invalid, torch.full_like(src_rows, -1), src_rows), rows
