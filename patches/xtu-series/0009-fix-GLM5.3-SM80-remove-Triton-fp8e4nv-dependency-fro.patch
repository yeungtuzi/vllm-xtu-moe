From 13563a12d0740dce67fb1599315b477b548522f3 Mon Sep 17 00:00:00 2001
From: xtu-glm53 <xtu@local>
Date: Fri, 18 Sep 2026 19:34:25 +0000
Subject: [PATCH 09/16] fix(GLM5.3/SM80): remove Triton fp8e4nv dependency from
 the kpool FP8 quantizers

First A100 bring-up of GLM-5.3-Flash died in determine_available_memory with:

  ValueError("type fp8e4nv not supported in this architecture. The supported
              fp8 dtypes are ('fp8e4b15', 'fp8e5')")
  at _fwht_quant_kernel

Same class of bug the DSv4.1 SM80 patches fixed: Triton has no fp8e4nv type on
Ampere/Ada, and the kpool kernels used torch.float8_e4m3fn tensors as store
targets, so Triton inferred fp8e4nv pointers.

- Import _f32_to_e4m3_uint8 (already used by the DSv4/v4.1 SM80 fixes) and
  encode the e4m3 bytes arithmetically at the four store sites:
  _fwht_quant_kernel, the softmax-rotate-write kernel's cache store and
  return_compressed store, and the decode update kernel's cache store.
- The Triton targets become uint8 buffers; the Python-level API still hands out
  float8_e4m3fn by viewing (fwht128_quant_fp8, kpool_compress_and_write_cache's
  return_compressed path). Byte layout is unchanged.

Only this model package is touched; dsv4/dsv4.1 have their own copies.

(cherry picked from commit 49490ee23cbd466197e8c4866dd20657fa4887dc)
---
 .../glm5next/nvidia/ops/kpool_compress.py     | 46 +++++++++++++------
 1 file changed, 32 insertions(+), 14 deletions(-)

diff --git a/vllm/models/glm5next/nvidia/ops/kpool_compress.py b/vllm/models/glm5next/nvidia/ops/kpool_compress.py
index 416d3b5c48..c2eac63bc8 100644
--- a/vllm/models/glm5next/nvidia/ops/kpool_compress.py
+++ b/vllm/models/glm5next/nvidia/ops/kpool_compress.py
@@ -14,6 +14,9 @@ from __future__ import annotations
 
 import torch
 
+from vllm.model_executor.layers.quantization.utils.fp8_utils import (
+    _f32_to_e4m3_uint8,
+)
 from vllm.triton_utils import tl, triton
 
 # The GLM-5.3-Flash indexer head dimension is fixed at 128.
@@ -101,7 +104,14 @@ def _fwht_quant_kernel(
     scale = tl.exp2(tl.ceil(tl.log2(absmax * (1.0 / 448.0))))
     y = tl.minimum(tl.maximum(x / scale[:, None], -448.0), 448.0)
 
-    tl.store(qout_ptr + rows[:, None] * 128 + offs[None, :], y, mask=rmask[:, None])
+    # The fp8 destinations are uint8 buffers and the e4m3 bytes are encoded
+    # arithmetically, because Triton has no fp8e4nv type on Ampere/Ada (SM8x).
+    # _f32_to_e4m3_uint8 is bit-identical to the old fp8 cast.
+    tl.store(
+        qout_ptr + rows[:, None] * 128 + offs[None, :],
+        _f32_to_e4m3_uint8(y),
+        mask=rmask[:, None],
+    )
     tl.store(sout_ptr + rows, scale, mask=rmask)
 
 
@@ -122,14 +132,16 @@ def fwht128_quant_fp8(q: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
     assert q.dtype == torch.bfloat16
     assert q.is_contiguous()
     n_rows = q.shape[0]
-    q_fp8 = torch.empty((n_rows, 128), dtype=torch.float8_e4m3fn, device=q.device)
+    # uint8 destination: the kernel encodes the e4m3 bytes arithmetically so the
+    # op compiles on SM8x (no Triton fp8e4nv). Viewed back for the caller.
+    q_fp8 = torch.empty((n_rows, 128), dtype=torch.uint8, device=q.device)
     q_scale = torch.empty((n_rows, 1), dtype=torch.float32, device=q.device)
     if n_rows == 0:
-        return q_fp8, q_scale
+        return q_fp8.view(torch.float8_e4m3fn), q_scale
     BLOCK_R = 32
     grid = (triton.cdiv(n_rows, BLOCK_R),)
     _fwht_quant_kernel[grid](q, q_fp8, q_scale, n_rows, BLOCK_R=BLOCK_R, num_warps=2)
-    return q_fp8, q_scale
+    return q_fp8.view(torch.float8_e4m3fn), q_scale
 
 
 # Fused pool compression and cache write.
@@ -244,13 +256,15 @@ def _kpool_softmax_rotate_write_cache_kernel(
             + S_OFFSET_NBYTES_IN_PAGE // 4
             + loc_token_offset_in_page
         )
-        tl.store(buf_fp8_ptr + out_k_offsets, quantized, mask=mask)
+        tl.store(
+            buf_fp8_ptr + out_k_offsets, _f32_to_e4m3_uint8(quantized), mask=mask
+        )
         tl.store(buf_fp32_ptr + out_s_offset, scale, mask=do_write)
 
     if RETURN_COMPRESSED:
         tl.store(
             compressed_k_ptr + row * HEAD_DIM + offs,
-            quantized,
+            _f32_to_e4m3_uint8(quantized),
             mask=offs < HEAD_DIM,
         )
         tl.store(compressed_scale_ptr + row, scale)
@@ -322,7 +336,6 @@ def kpool_compress_and_write_cache(
             )
         return None
 
-    buf_fp8 = buf.view(torch.float8_e4m3fn)
     buf_fp32 = buf.view(torch.float32)
     # bytes per page (last dim of kv_cache) viewed as uint8
     buf_numel_per_page = buf.stride(0)
@@ -331,18 +344,20 @@ def kpool_compress_and_write_cache(
     if return_compressed:
         compressed_k = torch.empty(
             (slot_k.shape[0], head_dim),
-            dtype=torch.float8_e4m3fn,
+            dtype=torch.uint8,
             device=slot_k.device,
         )
         compressed_scale = torch.empty(
             (slot_k.shape[0],), dtype=torch.float32, device=slot_k.device
         )
     else:
-        compressed_k = buf_fp8
+        compressed_k = buf
         compressed_scale = buf_fp32
 
+    # The kernel writes e4m3 bytes arithmetically into uint8 targets (SM8x has
+    # no Triton fp8e4nv), so pass the uint8 view rather than the fp8 one.
     _kpool_softmax_rotate_write_cache_kernel[(slot_k.shape[0],)](
-        buf_fp8,
+        buf,
         buf_fp32,
         slot_k,
         slot_score,
@@ -369,7 +384,7 @@ def kpool_compress_and_write_cache(
     )
 
     if return_compressed:
-        return compressed_k, compressed_scale
+        return compressed_k.view(torch.float8_e4m3fn), compressed_scale
     return None
 
 
@@ -608,7 +623,11 @@ def _kpool_decode_update_batched_kernel(
                 + S_OFFSET_NBYTES_IN_PAGE // 4
                 + loc_token_offset_in_page
             )
-            tl.store(buf_fp8_ptr + out_k_offsets, quantized, mask=dim_mask)
+            tl.store(
+                buf_fp8_ptr + out_k_offsets,
+                _f32_to_e4m3_uint8(quantized),
+                mask=dim_mask,
+            )
             tl.store(buf_fp32_ptr + out_s_offset, scale)
 
         # Stash the current token AFTER any completion read so the completion
@@ -687,7 +706,6 @@ def kpool_decode_update_and_maybe_write_cache_batched(
 
     page_size = kv_cache.shape[1]
     buf = kv_cache
-    buf_fp8 = buf.view(torch.float8_e4m3fn)
     buf_fp32 = buf.view(torch.float32)
 
     # The kernel indexes the int tensors as ``req * next_n + t`` (row-major),
@@ -699,7 +717,7 @@ def kpool_decode_update_and_maybe_write_cache_batched(
     positions = positions.contiguous()
 
     _kpool_decode_update_batched_kernel[(num_requests,)](
-        buf_fp8,
+        buf,
         buf_fp32,
         tail_kv_cache,
         tail_slot_mapping,
