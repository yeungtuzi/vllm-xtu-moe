From 7ee3f03e01102bfc8f6407a30ec907305ae4b101 Mon Sep 17 00:00:00 2001
From: xtu-glm53 <xtu@local>
Date: Fri, 18 Sep 2026 17:17:15 +0000
Subject: [PATCH 07/16] feat(GLM5.3/SM80): portable Triton sparse-MLA
 forward-with-sink kernel

Adds `sparse_mla_fwd_with_sink` + `_sparse_mla_fwd_with_sink_kernel`: the
SM8x (Ampere/Ada) replacement for the SM90+ `flash_mla_sparse_fwd` contract
(flat gathered-row ids into a shared bf16 kv table + per-query topk_length +
attention sink). Pure Triton; a new function appended to the existing portable
sparse-MLA kernel module, so no existing kernel or call site changes.

Ported from the LvLLM SM8x work (itself ported from the SGLang SM80 effort).

Verified on A100 (SM80): scripts/test_sparse_mla_fwd_sink.py compares against a
float32 torch reference over 8 cases (head 512 NoPE / 576 V3.2, index_topk up to
2048, partial topk_length, negative index padding, head padding, sink = -1e30):
worst max_abs 3.9e-3, worst peak-normalized rel 3.7e-3, 3 runs bit-identical.

No compatibility impact: the file gains two new top-level symbols only.

(cherry picked from commit bee4705b8528c341d6e4723d38b41e09f8e6b25b)
---
 .../backends/mla/sparse_mla_kernels.py        | 148 ++++++++++++++++++
 1 file changed, 148 insertions(+)

diff --git a/vllm/v1/attention/backends/mla/sparse_mla_kernels.py b/vllm/v1/attention/backends/mla/sparse_mla_kernels.py
index bd3986c971..84c1a0ab80 100644
--- a/vllm/v1/attention/backends/mla/sparse_mla_kernels.py
+++ b/vllm/v1/attention/backends/mla/sparse_mla_kernels.py
@@ -3515,3 +3515,151 @@ def finish_sparse_mla_attention_with_sink(
         BLOCK_D=block_d,
         num_warps=4,
     )
+
+
+@triton.jit
+def _sparse_mla_fwd_with_sink_kernel(
+    q_ptr,
+    kv_ptr,
+    indices_ptr,
+    lens_ptr,
+    attn_sink_ptr,
+    output_ptr,
+    stride_q_t,
+    stride_q_h,
+    stride_q_d,
+    stride_kv_r,
+    stride_kv_d,
+    stride_idx_t,
+    stride_idx_k,
+    stride_out_t,
+    stride_out_h,
+    stride_out_d,
+    qk_scale,
+    num_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    topk: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    # One program per (query, head); online softmax over gathered rows.
+    token_idx = tl.program_id(0)
+    head_idx = tl.program_id(1)
+    dim_offsets = tl.arange(0, BLOCK_D)
+    dim_mask = dim_offsets < head_dim
+
+    q = tl.load(
+        q_ptr
+        + token_idx * stride_q_t
+        + head_idx * stride_q_h
+        + dim_offsets * stride_q_d,
+        mask=dim_mask,
+        other=0.0,
+    ).to(tl.float32)
+
+    length = tl.load(lens_ptr + token_idx)
+    running_max = tl.load(attn_sink_ptr + head_idx).to(tl.float32)
+    running_denom = 1.0
+    running_acc = tl.zeros((BLOCK_D,), tl.float32)
+
+    for k_start in range(0, topk, BLOCK_K):
+        candidates = k_start + tl.arange(0, BLOCK_K)
+        k_mask = (candidates < length) & (candidates < topk)
+        row = tl.load(
+            indices_ptr + token_idx * stride_idx_t + candidates * stride_idx_k,
+            mask=k_mask,
+            other=0,
+        ).to(tl.int64)
+        row_safe = tl.where(k_mask, tl.maximum(row, 0), 0)
+        kv = tl.load(
+            kv_ptr + row_safe[:, None] * stride_kv_r + dim_offsets[None, :] * stride_kv_d,
+            mask=k_mask[:, None] & dim_mask[None, :],
+            other=0.0,
+        ).to(tl.float32)
+        scores = tl.sum(kv * q[None, :], axis=1) * qk_scale
+        scores = tl.where(k_mask, scores, -float("inf"))
+        next_max = tl.maximum(running_max, tl.max(scores, axis=0))
+        previous_weight = tl.exp(running_max - next_max)
+        weights = tl.exp(scores - next_max)
+        running_acc = running_acc * previous_weight + tl.sum(
+            kv * weights[:, None], axis=0
+        )
+        running_denom = running_denom * previous_weight + tl.sum(weights, axis=0)
+        running_max = next_max
+
+    tl.store(
+        output_ptr
+        + token_idx * stride_out_t
+        + head_idx * stride_out_h
+        + dim_offsets * stride_out_d,
+        running_acc / running_denom,
+        mask=dim_mask,
+    )
+
+
+def sparse_mla_fwd_with_sink(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    topk_length: torch.Tensor,
+    scale: float,
+    attn_sink: torch.Tensor,
+    output: torch.Tensor,
+    num_heads: int | None = None,
+) -> None:
+    """Sink-aware sparse MLA prefill over gathered BF16 KV rows.
+
+    Kernel-equivalent to the SM90+ ``flash_mla_sparse_fwd`` contract (flat row
+    indices into a shared ``kv`` table plus a per-query ``topk_length``), but
+    written in portable Triton so it runs on SM8x. Ported from the LvLLM SM8x
+    work, itself ported from the SGLang SM80 effort.
+
+    Args:
+        q: ``(Tq, H, D)`` queries (a leading unit head axis is accepted).
+        kv: ``(R, D)`` gathered KV rows shared by all queries.
+        indices: ``(Tq, K)`` int row ids into ``kv``; entries past
+            ``topk_length`` may be negative and are masked.
+        topk_length: ``(Tq,)`` int valid prefix length per query.
+        scale: softmax scale.
+        attn_sink: ``(H,)`` sink logits folded in as an extra softmax term.
+        output: ``(Tq, H, D)`` destination (heads past ``num_heads`` are zeroed).
+        num_heads: number of valid heads; defaults to ``q.shape[1]``.
+    """
+    if q.dim() == 4:
+        assert q.shape[1] == 1
+        q = q[:, 0]
+    if output.dim() == 4:
+        assert output.shape[1] == 1
+        output = output[:, 0]
+    active_heads = num_heads if num_heads is not None else q.shape[1]
+    num_tokens = q.shape[0]
+    topk = indices.shape[-1]
+    head_dim = q.shape[-1]
+    block_d = 512 if head_dim <= 512 else next_power_of_2(head_dim)
+    _sparse_mla_fwd_with_sink_kernel[(num_tokens, active_heads)](
+        q,
+        kv,
+        indices,
+        topk_length,
+        attn_sink,
+        output,
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        kv.stride(0),
+        kv.stride(1),
+        indices.stride(0),
+        indices.stride(1),
+        output.stride(0),
+        output.stride(1),
+        output.stride(2),
+        scale,
+        active_heads,
+        head_dim,
+        topk,
+        BLOCK_K=16,
+        BLOCK_D=block_d,
+        num_warps=8,
+    )
+    if q.shape[1] > active_heads:
+        output[:, active_heads:].zero_()
