+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-only tests for MiMo-V2 MTP depth-layer selection.
+
+The checkpoint ships ``num_nextn_predict_layers`` trained depth layers
+(``model.mtp.layers.{0..N-1}``). The draft must build only the depths a run can
+reach, and must fail closed when the checkpoint does not actually carry a depth
+it was asked to build.
+"""
+
+import pytest
+
+from vllm.model_executor.models.mimo_v2_mtp import (
+    _resolve_num_mtp_layers,
+    _verify_mtp_depths_loaded,
+)
+
+pytestmark = pytest.mark.cpu_test
+
+
+@pytest.mark.parametrize(
+    ("checkpoint_depths", "num_speculative_tokens", "expected"),
+    [
+        (3, 1, 1),  # k < depth: a k=1 run must not pay for depths 1..2
+        (3, 3, 3),  # k == depth: use every trained depth
+        (3, 5, 3),  # k > depth: clamp to the checkpoint and reuse its last depth
+        (1, 4, 1),  # single-depth checkpoints keep the upstream layer-0 reuse
+        (3, None, 3),  # unset k uses every checkpoint depth
+    ],
+)
+def test_num_mtp_layers_is_capped_by_checkpoint_and_k(
+    checkpoint_depths: int, num_speculative_tokens: int | None, expected: int
+):
+    assert (
+        _resolve_num_mtp_layers(checkpoint_depths, num_speculative_tokens) == expected
+    )
+
+
+def test_checkpoint_without_depth_layers_fails_closed():
+    with pytest.raises(ValueError, match="at least one depth layer"):
+        _resolve_num_mtp_layers(0, 3)
+
+
+def test_missing_depth_weights_fail_closed():
+    loaded = {
+        "model.embed_tokens.weight",
+        "model.mtp.layers.0.enorm.weight",
+    }
+    missing = r"missing weights for depth layer\(s\) \[1, 2\]"
+    with pytest.raises(ValueError, match=missing):
+        _verify_mtp_depths_loaded(3, loaded)
+
+
+def test_all_depth_weights_loaded_passes():
+    loaded = {f"model.mtp.layers.{depth}.enorm.weight" for depth in range(3)}
+    _verify_mtp_depths_loaded(3, loaded)
