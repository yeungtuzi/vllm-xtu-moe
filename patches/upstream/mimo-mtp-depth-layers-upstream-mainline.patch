+def _resolve_num_mtp_layers(
+    checkpoint_depths: int, num_speculative_tokens: int | None
+) -> int:
+    """Number of MTP depth layers to instantiate for a MiMo-V2 checkpoint.
+
+    The checkpoint ships ``num_nextn_predict_layers`` trained depths, but a run
+    only reaches the first ``num_speculative_tokens`` of them, so build the
+    smaller of the two. Requests deeper than the checkpoint reuse its last
+    layer through ``spec_step_idx % num_mtp_layers``.
+
+    Args:
+        checkpoint_depths: ``num_nextn_predict_layers`` of the checkpoint.
+        num_speculative_tokens: Requested draft depth; ``None`` uses every
+            checkpoint depth.
+
+    Returns:
+        The number of ``model.mtp.layers.*`` modules to build.
+
+    Raises:
+        ValueError: If the checkpoint declares no MTP depth layer.
+    """
+    if checkpoint_depths < 1:
+        raise ValueError(
+            "MiMo-V2 MTP requires a checkpoint with at least one depth layer "
+            "(num_nextn_predict_layers >= 1)."
+        )
+    if not num_speculative_tokens:
+        return checkpoint_depths
+    return min(checkpoint_depths, num_speculative_tokens)
+
+
+def _verify_mtp_depths_loaded(num_mtp_layers: int, loaded_params: set[str]) -> None:
+    """Fail closed when a built depth layer received no checkpoint weights.
+
+    A checkpoint whose config declares more depths than its weight files hold
+    would otherwise leave the extra layers randomly initialized and silently
+    draft garbage.
+    """
+    if not is_mtp_completeness_check_enabled():
+        return
+    loaded_depths = {
+        int(name.split(".")[3])
+        for name in loaded_params
+        if name.startswith("model.mtp.layers.")
+    }
+    missing = [depth for depth in range(num_mtp_layers) if depth not in loaded_depths]
+    if missing:
+        raise ValueError(
+            "MiMo-V2 MTP checkpoint is missing weights for depth layer(s) "
+            f"{missing}; it does not ship the requested MTP depths."
+        )
 
 
