     "fieldConfig": {
      "defaults": {
       "unit": "s",
       "custom": {
        "lineWidth": 2,
        "fillOpacity": 8,
        "showPoints": "never",
        "gradientMode": "opacity",
        "spanNulls": true
       }
      },
      "overrides": []
