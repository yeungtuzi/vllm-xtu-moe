{
 "title": "DSH · vLLM + LMCache + 主机",
 "uid": "dsh-overview",
 "tags": [
  "vllm",
  "lmcache",
  "host",
  "overview"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "editable": true,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "并发请求",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vllm:num_requests_running",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "排队请求",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vllm:num_requests_waiting",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "KV 使用率",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "vllm:kv_cache_usage_perc * 100",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "前缀命中率(vLLM)",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * sum(vllm:prefix_cache_hits_total) / clamp_min(sum(vllm:prefix_cache_queries_total),1)",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "LMCache 命中率",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * sum(lmcache_mp_lookup_hit_tokens_total) / clamp_min(sum(lmcache_mp_lookup_requested_tokens_total),1)",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "投机接受率",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "100 * sum(vllm:spec_decode_num_accepted_tokens_total) / clamp_min(sum(vllm:spec_decode_num_draft_tokens_total),1)",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   }
  },
  {
