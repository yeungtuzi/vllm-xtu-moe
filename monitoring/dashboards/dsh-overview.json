     "targets": [
      {
       "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
       "refId": "A",
       "legendFormat": "p50"
      }
     ],
     "options": {
      "legend": {
       "displayMode": "list",
       "placement": "bottom",
       "showLegend": true
